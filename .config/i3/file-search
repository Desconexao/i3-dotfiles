#!/bin/sh
# Find filenames with ripgrep and open the selection without evaluating it.
set -u

for dependency in rg rofi xdg-open; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send 'File search' "Required program not found: $dependency" || true
        fi
        printf 'File search: missing %s\n' "$dependency" >&2
        exit 1
    fi
done

root="${1:-$HOME}"
root="$(CDPATH= cd -- "$root" && pwd)" || exit 1
cd -- "$root" || exit 1

# Rofi reads the list asynchronously so filtering can start during the scan.
# Hidden files are omitted; symlinks include folders stored on other disks.
selected="$(rg --files --follow \
    -g '!**/node_modules/**' -g '!**/target/**' -g '!**/venv/**' \
    -g '!**/__pycache__/**' -g '!**/hayase-cache/**' 2>/dev/null |
    rofi -theme "$HOME/.config/i3/file-search.rasi" \
        -dmenu -i -no-custom -matching normal -sort -ellipsize-mode start -p 'Find files' \
        -kb-custom-1 'Alt+Return' \
        -mesg 'Type a filename · Enter: open · Alt+Enter: open folder · Esc: cancel')"
result=$?
case "$result" in 0|10) ;; *) exit 0 ;; esac
[ -n "$selected" ] || exit 0
path="$root/$selected"
[ -f "$path" ] || exit 0

if [ "$result" -eq 10 ]; then
    exec xdg-open "$(dirname -- "$path")"
fi
exec xdg-open "$path"
