/* Explicit states prevent the system's default theme from leaking through. */
* {
    font: "Noto Sans 12";
    background-color: transparent;
    text-color: #e6e9f5;
    border-color: #343c57;
    spacing: 0px;
}
window {
    width: 560px;
    location: center;
    anchor: center;
    border: 2px;
    background-color: #101522;
    border-radius: 20px;
    padding: 26px;
}
mainbox { children: [ inputbar, message, listview ]; spacing: 18px; }
inputbar { padding: 15px 17px; background-color: #1b2337; border-radius: 12px; spacing: 12px; }
prompt { text-color: #b8a6ff; font: "Noto Sans Bold 13"; }
entry { placeholder: "Search…"; placeholder-color: #77829e; text-color: #ffffff; }
message { border: 0px; padding: 0px 4px 4px; }
textbox { text-color: #929fbb; font: "Noto Sans 10"; }
listview { lines: 7; columns: 1; fixed-height: false; scrollbar: true; spacing: 8px; }
element { padding: 15px 16px; border: 1px; border-color: #232d44; border-radius: 12px; spacing: 14px; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 30px; }
element normal.normal, element alternate.normal { background-color: #171f30; text-color: #d5def1; }
element selected.normal { background-color: #b9a3ff; text-color: #171124; border-color: #d1c3ff; }
element normal.active, element alternate.active { background-color: #152e2c; text-color: #83e6c0; border-color: #255247; }
element selected.active { background-color: #83e6c0; text-color: #10251f; border-color: #b3f6de; }
element normal.urgent, element alternate.urgent { background-color: #35202c; text-color: #ffa4b5; }
element selected.urgent { background-color: #ffa4b5; text-color: #32121c; }
scrollbar { width: 3px; handle-color: #536180; background-color: #1b2337; }
