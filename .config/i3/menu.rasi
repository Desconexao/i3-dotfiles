/* Explicit states prevent the system's default theme from leaking through. */
* {
    font: "Noto Sans 12";
    background-color: transparent;
    text-color: #dddddd;
    border-color: #333333;
    spacing: 0px;
}
window {
    width: 560px;
    location: center;
    anchor: center;
    border: 1px;
    background-color: #080808;
    border-radius: 12px;
    padding: 20px;
}
mainbox { children: [ inputbar, message, listview ]; spacing: 18px; }
inputbar { padding: 15px 17px; background-color: #151515; border-radius: 8px; spacing: 12px; }
prompt { text-color: #eeeeee; font: "Noto Sans Bold 13"; }
entry { placeholder: "Search…"; placeholder-color: #888888; text-color: #ffffff; }
message { border: 0px; padding: 0px 4px 4px; }
textbox { text-color: #999999; font: "Noto Sans 10"; }
listview { lines: 7; columns: 1; fixed-height: false; scrollbar: true; spacing: 8px; }
element { padding: 12px 14px; border: 1px; border-color: #222222; border-radius: 7px; spacing: 14px; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 30px; }
element normal.normal, element alternate.normal { background-color: #111111; text-color: #cccccc; }
element selected.normal { background-color: #303030; text-color: #ffffff; border-color: #555555; }
element normal.active, element alternate.active { background-color: #181818; text-color: #ffffff; }
element selected.active { background-color: #303030; text-color: #ffffff; border-color: #555555; }
element normal.urgent, element alternate.urgent { background-color: #202020; text-color: #ffffff; }
element selected.urgent { background-color: #383838; text-color: #ffffff; }
scrollbar { width: 3px; handle-color: #555555; background-color: #151515; }
