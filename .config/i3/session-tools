#!/bin/sh
# Small, dependency-aware actions used by the i3 configuration.
set -eu

has() { command -v "$1" >/dev/null 2>&1; }

notify() {
    has notify-send || return 0
    notify-send -r 9125 -u low -t 1500 "$1" "$2"
}

case "${1:-}" in
    network-applet) has nm-applet && exec nm-applet ;;
    prewarm-terminal) has kitty && exec kitty --single-instance --class kitty-prewarm ;;
    terminal)
        if has kitty; then exec kitty --single-instance; fi
        exec i3-sensible-terminal
        ;;
    browser)
        if [ -n "${BROWSER:-}" ] && has "$BROWSER"; then exec "$BROWSER"; fi
        if has brave-browser; then exec brave-browser; fi
        if has firefox; then exec firefox; fi
        ;;
    files)
        if has nautilus; then exec nautilus --new-window; fi
        if has thunar; then exec thunar; fi
        has xdg-open && exec xdg-open "$HOME"
        ;;
    configure-input)
        has xinput || exit 0
        # Use constant mouse sensitivity. Detect profile length for both older
        # libinput drivers and drivers with the additional custom profile.
        xinput list --short | awk '/slave[[:space:]]+pointer/ {for (i = 1; i <= NF; i++) if ($i ~ /^id=/) {sub(/^id=/, "", $i); print $i}}' | while IFS= read -r device_id; do
            properties="$(xinput list-props "$device_id" 2>/dev/null || true)"
            printf '%s\n' "$properties" | grep -q 'libinput Tapping Enabled' && continue
            flat_profile="$(printf '%s\n' "$properties" | awk '
                /libinput Accel Profiles Available \(/ {
                    sub(/^.*:[[:space:]]*/, "")
                    count = split($0, profiles, /,[[:space:]]*/)
                    if (profiles[2] + 0 == 1) {
                        for (i = 1; i <= count; i++) printf "%s%d", (i == 1 ? "" : " "), (i == 2 ? 1 : 0)
                    }
                }
            ')"
            [ -n "$flat_profile" ] || continue
            set -- $flat_profile
            xinput set-prop "$device_id" 'libinput Accel Profile Enabled' "$@" 2>/dev/null || true
        done
        xinput list --name-only 2>/dev/null | awk '/[Tt]ouchpad/' | while IFS= read -r device; do
            xinput set-prop "$device" 'libinput Tapping Enabled' 1 2>/dev/null || true
            xinput set-prop "$device" 'libinput Natural Scrolling Enabled' 1 2>/dev/null || true
        done
        ;;
    wallpaper)
        wallpaper_file="$HOME/.config/i3/wallpaper"
        [ -r "$wallpaper_file" ] || exit 0
        IFS= read -r wallpaper_path < "$wallpaper_file" || exit 0
        [ -f "$wallpaper_path" ] && has feh && exec feh --no-fehbg --bg-fill "$wallpaper_path"
        ;;
    volume)
        has wpctl || exit 0
        case "${2:-}" in
            up) wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; notify 'Microphone' 'Mute toggled'; exit 0 ;;
            *) exit 2 ;;
        esac
        volume_state="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
        if printf '%s\n' "$volume_state" | grep -q '\[MUTED\]'; then notify 'Volume' 'Muted'; else notify 'Volume' "$(printf '%s\n' "$volume_state" | awk 'NF >= 2 {printf "%.0f%%", $2 * 100}')"; fi
        ;;
    brightness)
        has brightnessctl || exit 0
        case "${2:-}" in up) brightnessctl set +5% ;; down) brightnessctl set 5%- ;; *) exit 2 ;; esac
        notify 'Brightness' "$(brightnessctl -m 2>/dev/null | awk -F, 'NR == 1 {print $4}')"
        ;;
    power-profile)
        has powerprofilesctl || exit 0
        profile="${2:?profile required}"
        powerprofilesctl set "$profile"
        notify 'Power profile' "$profile"
        ;;
esac
