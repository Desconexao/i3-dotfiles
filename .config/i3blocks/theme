#!/bin/sh
# BAR CONTENT THEME — edit labels, icons and spacing here.
# JetBrainsMono Nerd Font is active in ../i3/bar-theme.conf.
BAR_USE_NERD_ICONS=1

bar_label() {
    key="$1"
    if [ "$BAR_USE_NERD_ICONS" = 1 ]; then
        case "$key" in
            wifi) printf '󰤨' ;; ethernet) printf '󰈀' ;; volume) printf '󰕾' ;; mute) printf '󰖁' ;;
            battery) printf '󰁹' ;; power) printf '󰾅' ;; temperature) printf '' ;;
            disk) printf '󰋊' ;; cpu) printf '󰻠' ;; memory) printf '' ;; time) printf '󰥔' ;;
        esac
    else
        case "$key" in
            wifi) printf 'Wi-Fi' ;; ethernet) printf 'Ethernet' ;; volume) printf 'Vol' ;; mute) printf 'Mute' ;;
            battery) printf 'Bat' ;; power) printf 'Pwr' ;; temperature) printf 'Temp' ;;
            disk) printf 'Disk' ;; cpu) printf 'CPU' ;; memory) printf 'RAM' ;; time) printf 'Clock' ;;
        esac
    fi
}
