# Appearance is centralized in ../i3/bar-theme.conf and labels/icons in ./theme.
# BLOCK SPACING — change this number to adjust the horizontal space between blocks.
separator=false
separator_block_width=8
color=#d5def1
background=#101522
border=#343c57
border_top=0
border_bottom=0
border_left=0
border_right=0

[controls]
command=$HOME/.config/i3blocks/status controls
interval=once

[network]
command=$HOME/.config/i3blocks/status network
interval=10

[volume]
command=$HOME/.config/i3blocks/status volume
interval=1

[microphone]
command=$HOME/.config/i3blocks/status microphone
interval=1

[battery]
command=$HOME/.config/i3blocks/status battery
interval=5

[power]
command=$HOME/.config/i3blocks/status power
interval=5

[temperature]
command=$HOME/.config/i3blocks/status temperature
interval=10

[disk]
command=$HOME/.config/i3blocks/status disk
interval=30

[cpu]
command=$HOME/.config/i3blocks/status cpu
interval=5

[memory]
command=$HOME/.config/i3blocks/status memory
interval=5

[time]
command=$HOME/.config/i3blocks/status time
interval=1
