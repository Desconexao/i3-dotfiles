#!/bin/sh

. "$HOME/.config/i3blocks/theme"
block="$1"
label="$(bar_label "$block")"

case "$block" in
controls)
    if [ -n "${BLOCK_BUTTON:-}" ]; then
        "$HOME/.config/i3/quick-controls" >/dev/null 2>&1 &
    fi
    printf ' 󰒓 \n 󰒓 \n'
    ;;
network)
    case "${BLOCK_BUTTON:-}" in
        # The selector remains available even when Ethernet is currently active.
        1) [ -x "$HOME/.config/i3blocks/wifi-menu" ] && "$HOME/.config/i3blocks/wifi-menu" >/dev/null 2>&1 & ;;
        3) nm-connection-editor >/dev/null 2>&1 & ;;
    esac
    for path in /sys/class/net/en* /sys/class/net/eth*; do
        [ -e "$path" ] || continue
        if [ "$(cat "$path/carrier" 2>/dev/null)" = 1 ]; then
            printf '  %s Wired  \n  Wired  \n' "$(bar_label ethernet)"
            exit 0
        fi
    done
    wifi_network="$(nmcli -t -f ACTIVE,SSID,SIGNAL device wifi 2>/dev/null | awk -F: '$1 == "yes" {print $2 "|" $3; exit}')"
    ssid="${wifi_network%%|*}"; signal="${wifi_network#*|}"
    [ "$ssid" = "$wifi_network" ] && ssid=''
    if [ -n "$ssid" ]; then
        case "$signal" in ''|*[!0-9]*) wifi_label="$(bar_label wifi)" ;; [0-3][0-9]) wifi_label="$(bar_label wifi-weak)" ;; *) wifi_label="$(bar_label wifi)" ;; esac
        printf '  %s %s %s%%  \n  %s  \n' "$wifi_label" "$ssid" "$signal" "$ssid"
    else
        printf '  %s Offline  \n  Offline  \n' "$(bar_label wifi-off)"
    fi
    ;;
volume)
    case "${BLOCK_BUTTON:-}" in
        1) "$HOME/.config/i3/session-tools" volume mute ;; 3) pavucontrol >/dev/null 2>&1 & ;;
        4) "$HOME/.config/i3/session-tools" volume up ;; 5) "$HOME/.config/i3/session-tools" volume down ;;
    esac
    audio="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
    volume_number="$(printf '%s\n' "$audio" | awk 'NF >= 2 {printf "%.0f", $2 * 100}')"
    volume="${volume_number}%"
    if printf '%s\n' "$audio" | grep -q '\[MUTED\]'; then
        printf '  %s Muted  \n  Muted  \n' "$(bar_label mute)"
    elif [ -n "$volume_number" ]; then
        case "$volume_number" in [0-2][0-9]|3[0-3]) volume_label="$(bar_label volume-low)" ;; *) volume_label="$label" ;; esac
        printf '  %s %s  \n  %s  \n' "$volume_label" "$volume" "$volume"
    else
        printf '  %s —  \n  —  \n' "$label"
    fi
    ;;
microphone)
    if [ "${BLOCK_BUTTON:-}" = 1 ]; then
        "$HOME/.config/i3/session-tools" volume mic-mute >/dev/null 2>&1
    fi
    audio="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
    if [ -z "$audio" ]; then
        exit 0
    elif printf '%s\n' "$audio" | grep -q '\[MUTED\]'; then
        printf ' %s \n %s \n' "$(bar_label microphone-muted)" "$(bar_label microphone-muted)"
    else
        printf ' %s \n %s \n' "$label" "$label"
    fi
    ;;
battery)
    battery_dir=''
    for candidate in /sys/class/power_supply/BAT*; do
        [ -r "$candidate/capacity" ] || continue
        battery_dir="$candidate"
        break
    done
    capacity="$(cat "$battery_dir/capacity" 2>/dev/null || true)"
    state="$(cat "$battery_dir/status" 2>/dev/null || true)"
    if [ -n "$capacity" ]; then
        case "$state" in Charging|Full) battery_label="$(bar_label battery-charging)" ;; *) case "$capacity" in [0-1][0-9]|20) battery_label="$(bar_label battery-low)" ;; *) battery_label="$label" ;; esac ;; esac
        printf '  %s %s%%  \n  %s%%  \n' "$battery_label" "$capacity" "$capacity"
    else
        exit 0
    fi
    ;;
power)
    profile="$(powerprofilesctl get 2>/dev/null || true)"
    if [ -n "$profile" ]; then printf '  %s %s  \n  %s  \n' "$label" "$profile" "$profile"; fi
    ;;
temperature)
    # Prefer the CPU package temperature reported by lm-sensors; Dell virtual
    # sensors and /sys are fallbacks for machines without coretemp.
    value="$(sensors 2>/dev/null | awk '/^Package id 0:/ {v=$4; gsub(/[^0-9.]/, "", v); print int(v); exit} /^CPU:/ {v=$2; gsub(/[^0-9.]/, "", v); print int(v); exit}')"
    if [ -z "$value" ]; then
        source="$(find /sys/class/thermal /sys/class/hwmon -type f \( -name temp -o -name 'temp*_input' \) 2>/dev/null | head -n 1)"
        raw_value="$(cat "$source" 2>/dev/null || true)"
        case "$raw_value" in *[!0-9]*|'') ;; *) value=$((raw_value / 1000)) ;; esac
    fi
    if [ -n "$value" ]; then printf '  %s %s°C  \n  %s°C  \n' "$label" "$value" "$value"; fi
    ;;
disk|dlinux)
    if [ "${BLOCK_BUTTON:-}" = 1 ]; then
        "$HOME/.config/i3/storage-menu" >/dev/null 2>&1 &
    fi
    if [ "$block" = dlinux ]; then
        mountpoint -q /mnt/DLinux || exit 0
        target=/mnt/DLinux
        name=DLinux
    else
        target=/
        name=System
    fi
    value="$(df -h --output=avail "$target" | awk 'NR == 2 {print $1}')"
    printf '  %s %s %s free  \n  %s %s  \n' "$(bar_label disk)" "$name" "$value" "$name" "$value"
    ;;
cpu)
    value="$(awk '{print $1}' /proc/loadavg)"; printf '  %s %s  \n  %s  \n' "$label" "$value" "$value"
    ;;
memory)
    value="$(free -h | awk '/Mem:/ {print $3}')"; printf '  %s %s  \n  %s  \n' "$label" "$value" "$value"
    ;;
time)
    [ "${BLOCK_BUTTON:-}" = 1 ] && zenity --calendar --title='Calendar' --date-format='%d/%m/%Y' >/dev/null 2>&1 &
    printf '  %s ' "$label"; LC_TIME=C date '+%a %d %b  ·  %H:%M  '
    ;;
esac
